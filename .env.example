# Rally Health backend local configuration
RALLY_ENVIRONMENT=development
RALLY_API_KEY=replace-with-a-long-random-secret
RALLY_DATABASE_PATH=data/rally_health.sqlite3
RALLY_NORMALIZED_DATA_DIR=data/normalized
RALLY_SOURCE_DIR=.
RALLY_ANTHROPIC_ENABLED=false
RALLY_ANTHROPIC_MODEL=claude-opus-5-5
RALLY_CHAT_ENABLED=false
RALLY_CHAT_API_KEY=
RALLY_CHAT_BASE_URL=https://api.pinkyne.com/v1
RALLY_CHAT_MODEL=gpt-4o
RALLY_CHAT_TIMEOUT_SECONDS=90
RALLY_CHAT_HISTORY_TURNS=12
RALLY_OCR_ENABLED=false
RALLY_OCR_API_KEY=
RALLY_OCR_BASE_URL=https://api.pinkyne.com/v1
RALLY_OCR_MODEL=gpt-4o
RALLY_OCR_TIMEOUT_SECONDS=90
RALLY_MAX_CHAT_INPUT_CHARS=4000
RALLY_ALLOWED_ORIGINS=[]
